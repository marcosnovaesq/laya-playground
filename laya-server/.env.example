# Optional. If set, POST /v1/systemone requires `Authorization: Bearer <LAYA_API_KEY>`.
LAYA_API_KEY=

# Hugging Face model repo to load. Defaults to convaiinnovations/laya.
LAYA_MODEL_ID=convaiinnovations/laya

# torch device string (e.g. cuda, mps, cpu). Defaults to auto-detect.
LAYA_DEVICE=

# Set to 0 to lazy-load the model on first request instead of at server startup.
LAYA_EAGER_LOAD=1
